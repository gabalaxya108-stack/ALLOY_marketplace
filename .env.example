# ALLOY Marketplace Environment Configuration Template
# Duplicate this file as .env and fill in real values

# =============================================================================
# 1. AI Integration (Server-side Groq LLM for Smart Brief Pipeline)
# Obtain from: https://console.groq.com/keys
# =============================================================================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# =============================================================================
# 2. Supabase Cloud Configuration (Database, Realtime & Auth)
# Obtain from: Supabase Dashboard -> Project Settings -> API
# =============================================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VITE_SUPABASE_STORAGE_BUCKET=creasynq-media

# =============================================================================
# 3. Server & Local Dev
# =============================================================================
PORT=5173
NODE_ENV=development

# =============================================================================
# 4. Super Admin & Governance Portal
# =============================================================================
ALLOY_ADMIN_EMAIL=admin@alloy.market
ALLOY_ADMIN_PASSKEY=alloyadminmarketplace-2026
# Optional provisioning secret (min 16 chars) for one-time CLI/HTTP bootstrap
ALLOY_ADMIN_PROVISION_SECRET=

# =============================================================================
# 5. Designated Evaluation & Judge Account
# =============================================================================
VITE_JUDGE_EMAIL=judge@alloy.market
VITE_JUDGE_PASSWORD=JudgeAlloy2026!

# =============================================================================
# 6. Razorpay Payment Gateway (TEST MODE ONLY)
# Obtain Test Key ID & Secret from: https://dashboard.razorpay.com/#/app/keys
# Never commit real credentials or live keys.
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=
