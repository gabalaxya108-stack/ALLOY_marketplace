# ALLOY Marketplace Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# DO NOT COMMIT .env TO VERSION CONTROL

# =============================================================================
# 1. Razorpay Escrow / Payments (Test Mode)
# =============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# =============================================================================
# 2. AI Integration (Server-side Groq LLM for Smart Brief Pipeline)
# =============================================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# =============================================================================
# 3. Supabase Cloud Configuration (Database, Realtime & Auth)
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
# 4. Google OAuth 2.0 (Google Cloud Console)
# =============================================================================
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# =============================================================================
# 5. Super Admin & Governance Portal
# =============================================================================
ALLOY_ADMIN_EMAIL=admin@alloy.market
ALLOY_ADMIN_PASSKEY=alloyadminmarketplace-2026

# =============================================================================
# 6. Designated Evaluation & Judge Account
# =============================================================================
VITE_JUDGE_EMAIL=judge@alloy.market
VITE_JUDGE_PASSWORD=JudgeAlloy2026!